rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== KULLANICI PROFİLİ =====
    match /users/{userId} {
      // Herkes profil bilgilerini okuyabilir (leaderboard, profil sayfası)
      allow read: if request.auth != null;
      // Kullanıcı kendi profilini oluşturabilir/güncelleyebilir
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // Silme sadece admin
      allow delete: if request.auth != null && isAdmin();

      // Alt koleksiyonlar: words, data, flashcardDecks, ai_messages
      match /words/{wordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /flashcardDecks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ai_messages/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== ARŞİV (GLOBAL SÖZLÜK) =====
    match /archive/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== PHRASAL VERBS =====
    match /phrasalVerbs/{verbId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== GRAMER KONULARI =====
    match /grammarTopics/{topicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== GRAMER AÇIKLAMALARI =====
    match /grammarExplanations/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ===== GERİ BİLDİRİMLER =====
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAdmin();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ===== GLOBAL DICTIONARY (FLASHCARDS) =====
    match /globalDictionary/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== ADMIN HELPER =====
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
