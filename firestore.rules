rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== KULLANICI PROFİLİ =====
    match /users/{userId} {
      // Herkes profil bilgilerini okuyabilir (leaderboard, profil sayfası)
      allow read: if request.auth != null;
      // Kullanıcı kendi profilini oluşturabilir/güncelleyebilir — AMA
      // role/premiumUntil/premiumType/publicStats alanlarını DOĞRUDAN
      // yazamaz (bkz. ydtfocus-mobile/TODO.md "Güvenlik notu"). Bu
      // alanlar sadece: (a) Admin SDK kullanan sunucu kodu (PayTR
      // callback, /api/play-billing/*, Cloud Functions — hepsi Admin
      // SDK ile çalıştığından bu kuralları zaten atlıyor) tarafından
      // yazılabilir. Çark/Hediye/Abonelik akışları artık functions/
      // altındaki spinWheel/claimWheelPrize/redeemGiftCode callable
      // fonksiyonlarını kullanıyor, client'ın bu alanlara hiç erişimi yok.
      // ensureUserProfile (mobil/web) yeni profil oluştururken role'ü
      // her zaman "free" yazıyor — bu yüzden create'te role'e izin
      // veriliyor ama SADECE "free" değeriyle.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == "free"
        && !("premiumUntil" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["role", "premiumUntil", "premiumType", "premiumSource", "publicStats"]);
      // Admin panelinin (admin/users/page.js → updateUserRole) başka
      // kullanıcıların role'ünü değiştirebilmesi için ayrı bir izin —
      // bu olmadan yukarıdaki `request.auth.uid == userId` şartı zaten
      // admin'in BAŞKA bir kullanıcı dökümanını güncellemesine hiç izin
      // vermiyordu (bu satır eklenmeden önce de öyleydi, bu PR'ın
      // sebep olduğu bir kısıtlama değil — fark edilip düzeltildi).
      allow update: if request.auth != null && isAdmin();
      // Silme sadece admin
      allow delete: if request.auth != null && isAdmin();

      // Alt koleksiyonlar: words, data, flashcardDecks, ai_messages
      match /words/{wordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /data/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // "wheel" dökümanı artık istemciden yazılamaz — pendingPrize
        // alanının client tarafından uydurulmasını engellemek için
        // spinWheel/claimWheelPrize Cloud Functions'a taşındı.
        allow write: if request.auth != null && request.auth.uid == userId && docId != "wheel";
      }

      match /flashcardDecks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ai_messages/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== ARŞİV (GLOBAL SÖZLÜK) =====
    match /archive/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== PHRASAL VERBS =====
    match /phrasalVerbs/{verbId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== GRAMER KONULARI =====
    match /grammarTopics/{topicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== GRAMER AÇIKLAMALARI =====
    match /grammarExplanations/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ===== GERİ BİLDİRİMLER =====
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAdmin();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ===== GLOBAL DICTIONARY (FLASHCARDS) =====
    match /globalDictionary/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ===== HEDİYE KODLARI (mobil: Çark Çevir / Arkadaşına Hediye Et) =====
    // Client'ın hiç doğrudan erişimi yok — oluşturma (claimWheelPrize
    // Cloud Function / api/play-billing/verify-gift) ve kullanma
    // (redeemGiftCode Cloud Function) tamamen Admin SDK üzerinden,
    // sunucu tarafında yapılıyor (Admin SDK bu kuralları zaten atlar).
    // Önceden client'ın kendi kodunu oluşturup redeemed alanını
    // güncelleyebildiği bir kural vardı — çark ödülünün/hediyenin
    // sahteciliğini (ör. days:9999 ile kendi kodunu oluşturup başka
    // hesapta kullanma) engellemek için bilerek TAMAMEN kapatıldı.
    match /giftCodes/{code} {
      allow read, write: if false;
    }

    // ===== ADMIN HELPER =====
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
